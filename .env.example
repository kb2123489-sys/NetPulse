# NetPulse 环境变量配置示例
# 复制此文件为 .env 并填入您的实际值

# Gemini API 配置
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL_FAST=
VITE_GEMINI_MODEL_DEEP=

# Tavily API 配置
VITE_TAVILY_API_KEY=
VITE_TAVILY_API_KEY_1=

# LLM 配置（支持OpenAI格式的API）
VITE_LLM_PROVIDER=openai
VITE_LLM_ENDPOINT=  # 自定义API端点，留空则使用默认

# 其他可选配置
VITE_GEMINI_PROXY_URL=